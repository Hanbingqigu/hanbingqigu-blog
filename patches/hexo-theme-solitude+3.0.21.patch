+.card-widget.card-recent-post
+    .item-headline
+        i.solitude.fas.fa-comment-dots
+        span= "一言"
+    //- 核心修改 1：加上 padding: 0 15px; 让整个内容区左右往里收缩 15 像素
+    .hitokoto-content(style="padding: 0 15px;")
+        //- 核心修改 2：加上 text-align: center; 让文字本身居中（如果你不想文字居中，删掉这句即可）
+        p#hitokoto_text(style="font-size: 14px; margin-top: 10px; line-height: 1.5;") 正在连接宇宙电波...
+        //- 作者文本保持靠右对齐
+        p#hitokoto_author(style="font-size: 13px; margin-top: 8px; text-align: right; opacity: 0.8;")
+    script.
+        fetch('https://v1.hitokoto.cn')
+        .then(res => res.json())
+        .then(data => {
+            document.getElementById('hitokoto_text').innerText = data.hitokoto;
+            document.getElementById('hitokoto_author').innerText = '—— ' + (data.from || '佚名');
+        })
+        .catch(console.error);
